{% assign repo_name = include.repository | split: '/' | last %}
<a class="repo-card" href="https://github.com/{{ include.repository }}"
   data-repo="{{ include.repository }}" target="_blank" rel="noopener">
  <div class="repo-card-title"><i class="fa-brands fa-github"></i> {{ repo_name }}</div>
  <p class="repo-card-desc"></p>
  <div class="repo-card-meta"></div>
</a>
